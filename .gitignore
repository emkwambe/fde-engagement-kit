.env
.venv/
__pycache__/
*.pyc
.terraform/
*.tfstate*
# eval reports: real-model runs are committed (trend tracking, docs/09 section 2.4); fake-model runs are not
engagements/*/evals/reports/*-fake-*
!engagements/*/evals/reports/.gitkeep
.pytest_cache/
.mypy_cache/
.ruff_cache/
# generated by `.\tasks.ps1 seed` (deterministic, so not committed)
engagements/*/data/tables/*.csv
# mock ERP runtime data (tickets created while testing)
services/mock-erp/data/
services/mock-cmms/data/
# terraform variables can hold project ids: keep real ones local
*.tfvars
!*.tfvars.example

# Copy to .env — never commit .env
#   Copy-Item .env.example .env
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna    # dev default; use gpt-6.1-terra for final evals + demo (see docs/12-cost-estimate.md)
FAKE_LLM=1              # 1 = deterministic fake models, no API key or cost. Set 0 to use OpenAI.
DATABASE_URL=postgresql://fde:fde@localhost:5432/fde
AGENT_RO_PASSWORD=agent_ro
AGENT_RO_DATABASE_URL=postgresql://agent_ro:agent_ro@localhost:5432/fde
ERP_API_URL=http://localhost:8100
ERP_API_TOKEN=dev-token
ADMIN_TOKEN=            # bearer token for POST /ingest and /eval; empty = admin endpoints disabled
OTEL_TRACES_EXPORTER=console   # console | otlp (set OTEL_EXPORTER_OTLP_ENDPOINT) | none
